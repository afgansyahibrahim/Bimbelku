APP_NAME=BimbelKu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
FEATURE_TEACHER_REPLACEMENT=true
FRONTEND_URL=http://127.0.0.1:8080
FRONTEND_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
CORS_MAX_AGE=600
APP_TIMEZONE=Asia/Jakarta
POLICY_VERSION=2026-07-29
PRIMARY_ADMIN_EMAIL=admin@bimbelku.com
SEED_ADMIN_EMAIL=admin@bimbelku.com
SEED_ADMIN_PASSWORD=
SEED_DEMO_USERS=false

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=bimbelku
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
# Brevo SMTP: ubah MAIL_MAILER=smtp lalu isi SMTP login dan SMTP key.
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@bimbelku.local"
MAIL_FROM_NAME="${APP_NAME}"

# Masa aktif token API dalam menit (12 jam).
SANCTUM_TOKEN_EXPIRATION=720
